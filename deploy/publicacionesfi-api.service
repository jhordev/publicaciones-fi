# /etc/systemd/system/publicacionesfi-api.service
[Unit]
Description=API Repositorio de Publicaciones FI
After=network.target mysql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/publicacionesfi/backend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
