# --- Servidor ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# --- Base de datos (usuario de aplicación con permisos solo sobre publicaciones_fi) ---
DATABASE_URL="mysql://pubfi_app:CAMBIAR@localhost:3306/publicaciones_fi"
DB_HOST=localhost
DB_PORT=3306
DB_USER=pubfi_app
DB_PASSWORD=CAMBIAR
DB_NAME=publicaciones_fi

# --- Sesiones ---
SESSION_SECRET=CAMBIAR_POR_CADENA_ALEATORIA_LARGA
# En producción con HTTPS poner true
COOKIE_SECURE=false
# Subruta pública de la app (la cookie de sesión solo viaja bajo esta ruta)
BASE_PATH=/publicacionesfi

# --- Archivos ---
STORAGE_DIR=../storage/archivos
MEDIA_DIR=../storage/imagenes
MAX_UPLOAD_MB=20

# --- Administrador inicial (usado solo por el seed) ---
SEED_ADMIN_EMAIL=admin@ucss.edu.pe
SEED_ADMIN_PASSWORD=CAMBIAR
